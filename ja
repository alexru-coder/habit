<!DOCTYPE html>

<html lang="de">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<meta name="theme-color" content="#10111b">

<title>HabitFlow</title>

<style>

:root {

  --bg:#10111b; --panel:#1b1d2b; --text:#f5f5fb;

  --muted:#9699b2; --accent:#a78bfa; --green:#68e0b0;

  --border:#303247;

}

* { box-sizing:border-box; }

body {

  margin:0; background:var(--bg); color:var(--text);

  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;

}

header,main { max-width:760px; margin:auto; }

header { padding:28px 20px 12px; }

.logo { color:var(--accent); font-size:13px; font-weight:800; letter-spacing:3px; }

h1 { font-size:32px; margin:10px 0 5px; }

h2 { font-size:18px; margin:0 0 15px; }

p { color:var(--muted); line-height:1.5; }

main { padding:12px 16px 40px; }

.card {

  background:var(--panel); border:1px solid var(--border);

  border-radius:20px; padding:18px; margin-bottom:16px;

}

.row { display:flex; gap:10px; align-items:center; }

input,button { font:inherit; border-radius:12px; padding:13px; }

input {

  background:#111320; color:var(--text);

  border:1px solid var(--border); min-width:0;

}

button { border:0; cursor:pointer; font-weight:700; }

.primary { background:var(--accent); color:#171126; }

#habitInput { width:100%; flex:1; }

.habit {

  display:flex; align-items:center; gap:12px;

  padding:13px 0; border-bottom:1px solid var(--border);

}

.habit:last-child { border-bottom:0; }

.check {

  width:29px; height:29px; flex-shrink:0; padding:0;

  border:2px solid #555873; background:transparent;

  color:white; border-radius:9px;

}

.check.done { background:var(--green); border-color:var(--green); color:#10251e; }

.habit-info { flex:1; min-width:0; }

.habit-name { font-weight:700; overflow-wrap:anywhere; }

.small { font-size:12px; color:var(--muted); margin-top:4px; }

.delete { background:transparent; color:var(--muted); padding:8px; }

.stats { display:grid; grid-template-columns:repeat(3,1fr); gap:9px; }

.stat { background:#111320; border-radius:14px; padding:13px 9px; }

.number { font-size:24px; font-weight:800; }

.label { font-size:11px; color:var(--muted); margin-top:5px; }

.bars {

  display:grid; grid-template-columns:repeat(7,1fr);

  gap:9px; height:135px; align-items:end;

  border-bottom:1px solid var(--border); padding-top:10px;

}

.day { display:flex; height:100%; flex-direction:column; justify-content:end; align-items:center; gap:7px; }

.track { width:100%; max-width:30px; height:90px; display:flex; align-items:end; background:#111320; border-radius:7px; overflow:hidden; }

.bar { width:100%; background:var(--accent); border-radius:7px; min-height:2px; }

.day span { font-size:10px; color:var(--muted); }

.sleep-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }

.sleep-grid label { font-size:12px; color:var(--muted); display:block; margin-bottom:7px; }

.sleep-grid input { width:100%; }

.sleep-result { color:var(--green); font-size:23px; font-weight:800; margin-top:14px; }

.history { display:grid; gap:8px; }

.history-row { display:flex; justify-content:space-between; gap:8px; font-size:13px; padding:10px 0; border-bottom:1px solid var(--border); }

footer { text-align:center; color:var(--muted); font-size:11px; padding:10px; }

</style>

</head>

<body>

<header>

  <div class="logo">HABITFLOW ✦</div>

  <h1>Dein Fortschritt.</h1>

  <p id="today"></p>

</header>

<main>

  <section class="card">

    <h2>📈 Deine Statistik</h2>

    <div class="stats">

      <div class="stat"><div class="number" id="percent">0%</div><div class="label">Heute geschafft</div></div>

      <div class="stat"><div class="number" id="total">0</div><div class="label">Gewohnheiten</div></div>

      <div class="stat"><div class="number" id="streak">0</div><div class="label">Tage am Stück</div></div>

    </div>

  </section>

  <section class="card">

    <h2>✨ Meine Gewohnheiten</h2>

    <form class="row" id="addForm">

      <input id="habitInput" placeholder="z. B. 8 Stunden schlafen" maxlength="70" required>

      <button class="primary" type="submit">＋ Hinzufügen</button>

    </form>

    <div id="habits"></div>

  </section>

  <section class="card">

    <h2>📊 Letzte 7 Tage</h2>

    <p class="small">Anteil der erledigten Gewohnheiten pro Tag.</p>

    <div class="bars" id="chart"></div>

    <p id="chartSummary" class="small"></p>

  </section>

  <section class="card">

    <h2>🌙 Mein Schlaf</h2>

    <p>Trage deine Schlafens- und Aufstehzeit ein.</p>

    <div class="sleep-grid">

      <div><label for="bed">Schlafen gegangen</label><input id="bed" type="time" value="23:00"></div>

      <div><label for="wake">Aufgestanden</label><input id="wake" type="time" value="07:00"></div>

    </div>

    <button class="primary" id="saveSleep" style="margin-top:12px;width:100%">Schlaf speichern</button>

    <div id="sleepResult" class="sleep-result">8 Std. 00 Min.</div>

    <div id="sleepHistory" class="history"></div>

  </section>

  <footer>HabitFlow · Deine Daten bleiben in diesem Browser.</footer>

</main>

<script>

const $ = id => document.getElementById(id);

const todayKey = () => {

  const d = new Date();

  return d.getFullYear() + "-" +

    String(d.getMonth()+1).padStart(2,"0") + "-" +

    String(d.getDate()).padStart(2,"0");

};

const shiftDate = (days) => {

  const d = new Date();

  d.setHours(12,0,0,0);

  d.setDate(d.getDate()+days);

  return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");

};

const read = (key, fallback) => {

  try {

    const v = localStorage.getItem("habitflow_"+key);

    return v === null ? fallback : JSON.parse(v);

  } catch { return fallback; }

};

const write = (key, value) => {

  try { localStorage.setItem("habitflow_"+key, JSON.stringify(value)); }

  catch { alert("Speichern nicht möglich. Bitte prüfe deinen Browser."); }

};

let habits = read("habits", []);

let logs = read("logs", {});

let sleeps = read("sleeps", {});

$("today").textContent = new Date().toLocaleDateString("de-DE", {

  weekday:"long", day:"numeric", month:"long", year:"numeric"

});

function doneCount(day) {

  return habits.filter(h => (logs[day] || []).includes(h.id)).length;

}

function streakCount() {

  if (!habits.length) return 0;

  let streak = 0;

  let start = 0;

  if (doneCount(todayKey()) !== habits.length) start = -1;

  for (let i=start; i>-365; i--) {

    const d = shiftDate(i);

    if (doneCount(d) === habits.length) streak++;

    else break;

  }

  return streak;

}

function render() {

  const today = todayKey();

  const done = doneCount(today);

  $("total").textContent = habits.length;

  $("percent").textContent = habits.length

    ? Math.round(done/habits.length*100)+"%" : "0%";

  $("streak").textContent = streakCount();

  $("habits").innerHTML = "";

  if (!habits.length) {

    $("habits").innerHTML =

      '<p class="small">Noch keine Gewohnheiten. Füge oben deine erste hinzu!</p>';

  }

  habits.forEach(h => {

    const isDone = (logs[today] || []).includes(h.id);

    const el = document.createElement("div");

    el.className = "habit";

    const check = document.createElement("button");

    check.className = "check"+(isDone ? " done" : "");

    check.textContent = isDone ? "✓" : "";

    check.setAttribute("aria-label", isDone ? "Erledigt" : "Abhaken");

    check.onclick = () => toggle(h.id);

    const info = document.createElement("div");

    info.className = "habit-info";

    const name = document.createElement("div");

    name.className = "habit-name";

    name.textContent = h.name;

    const sub = document.createElement("div");

    sub.className = "small";

    sub.textContent = isDone ? "Heute geschafft ✓" : "Heute noch offen";

    info.append(name, sub);

    const del = document.createElement("button");

    del.className = "delete";

    del.textContent = "✕";

    del.setAttribute("aria-label","Gewohnheit löschen");

    del.onclick = () => {

      if (confirm("Diese Gewohnheit wirklich löschen?")) {

        habits = habits.filter(x => x.id !== h.id);

        write("habits", habits);

        render();

      }

    };

    el.append(check, info, del);

    $("habits").append(el);

  });

  $("chart").innerHTML = "";

  let sum = 0;

  for (let i=6; i>=0; i--) {

    const date = shiftDate(-i);

    const count = doneCount(date);

    const pct = habits.length ? Math.round(count/habits.length*100) : 0;

    sum += pct;

    const day = document.createElement("div");

    day.className = "day";

    const track = document.createElement("div");

    track.className = "track";

    const bar = document.createElement("div");

    bar.className = "bar";

    bar.style.height = pct+"%";

    bar.title = pct+"% erledigt";

    track.append(bar);

    const label = document.createElement("span");

    label.textContent = new Date(date+"T12:00:00").toLocaleDateString("de-DE",{weekday:"short"}).slice(0,2);

    day.append(track,label);

    $("chart").append(day);

  }

  $("chartSummary").textContent = habits.length

    ? "Dein durchschnittlicher Tagesfortschritt: "+Math.round(sum/7)+"%"

    : "Erstelle Gewohnheiten, um dein Diagramm zu starten.";

  renderSleep();

}

function toggle(id) {

  const day = todayKey();

  logs[day] = logs[day] || [];

  logs[day] = logs[day].includes(id)

    ? logs[day].filter(x => x !== id)

    : [...logs[day], id];

  write("logs", logs);

  render();

}

$("addForm").addEventListener("submit", e => {

  e.preventDefault();

  const name = $("habitInput").value.trim();

  if (!name) return;

  habits.push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,7), name});

  write("habits", habits);

  $("habitInput").value = "";

  render();

});

function duration() {

  const [bh,bm] = $("bed").value.split(":").map(Number);

  const [wh,wm] = $("wake").value.split(":").map(Number);

  if (![bh,bm,wh,wm].every(Number.isFinite)) return null;

  let mins = (wh*60+wm)-(bh*60+bm);

  if (mins <= 0) mins += 1440;

  return mins;

}

function renderSleep() {

  const mins = duration();

  $("sleepResult").textContent = mins === null ? "Bitte Zeiten auswählen" :

    Math.floor(mins/60)+" Std. "+String(mins%60).padStart(2,"0")+" Min.";

  $("sleepHistory").innerHTML = "<p class='small'>Deine letzten Einträge</p>";

  Object.keys(sleeps).sort().reverse().slice(0,7).forEach(day => {

    const s = sleeps[day];

    const row = document.createElement("div");

    row.className = "history-row";

    const left = document.createElement("span");

    left.textContent = new Date(day+"T12:00:00").toLocaleDateString("de-DE",{day:"2-digit",month:"2-digit"});

    const right = document.createElement("span");

    right.textContent = s.bed+"–"+s.wake+" · "+Math.floor(s.mins/60)+"h "+String(s.mins%60).padStart(2,"0")+"m";

    row.append(left,right);

    $("sleepHistory").append(row);

  });

}

$("saveSleep").onclick = () => {

  const mins = duration();

  if (mins === null) return alert("Bitte wähle beide Uhrzeiten.");

  sleeps[todayKey()] = {

    bed:$("bed").value, wake:$("wake").value, mins

  };

  write("sleeps", sleeps);

  renderSleep();

  alert("Dein Schlaf wurde gespeichert! 🌙");

};

if (sleeps[todayKey()]) {

  $("bed").value = sleeps[todayKey()].bed;

  $("wake").value = sleeps[todayKey()].wake;

}

render();

</script>

</body>

</html>